# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Data — never commit raw corpora or derived splits
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts
artifacts/*
!artifacts/.gitkeep
*.onnx
*.pkl
*.pt
*.bin
*.safetensors

# Node / frontend
node_modules/
web/dist/
web/.vite/

# Notebooks
.ipynb_checkpoints/

# Environment / editor
.env
.env.*
.vscode/
.idea/
*.log

# Per-developer local settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json

# Frontend build output
web/dist/
web/node_modules/

# Appeal / correction reports — contain user-submitted advertisement text and
# optional contact details. Never commit these.
data/reports/

eval/results_dryrun.md
